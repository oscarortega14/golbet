# Copia este archivo a `.env` y ajusta los valores.
# En desarrollo, dotenv-rails carga automáticamente `.env` al arrancar.

# Contraseña del panel de administración (requerida; la app no arranca sin ella en development).
ADMIN_PASSWORD=cambia-esto

# Base de datos PostgreSQL (contenedor Docker: docker compose up -d).
# Estos son los defaults que ya usa config/database.yml; solo defínelos si cambias el contenedor.
DB_HOST=127.0.0.1
DB_PORT=5441
DB_USERNAME=golbet
DB_PASSWORD=golbet
